# DORASANI Supabase Configuration (Frontend - Safe Public Env Vars)
# Replace these with your project credentials from https://app.supabase.com
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key-here
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Server-Side Razorpay Secrets (Store strictly in Supabase Edge Function Secrets — NEVER add to VITE_ client env vars)
# Run:
#   npx supabase secrets set RAZORPAY_KEY_ID=rzp_test_xxxxx RAZORPAY_KEY_SECRET=xxxxx RAZORPAY_WEBHOOK_SECRET=xxxxx --project-ref irtvutkwjdjkghobnnct
#
# Configure Razorpay Dashboard Webhook URL:
#   https://irtvutkwjdjkghobnnct.supabase.co/functions/v1/payment-webhook
# Events: payment.captured, order.paid, payment.failed, refund.processed

# Server-Side Delhivery One Secrets (Store strictly in Supabase Edge Function Secrets — NEVER add to VITE_ client env vars)
# Run:
#   npx supabase secrets set DELHIVERY_API_TOKEN=your_delhivery_api_token DELHIVERY_BASE_URL=https://track.delhivery.com DELHIVERY_PICKUP_LOCATION="DORASANI SAREES B2C" --project-ref irtvutkwjdjkghobnnct
# Optional Webhook Secret:
#   npx supabase secrets set DELHIVERY_WEBHOOK_SECRET=your_random_webhook_secret --project-ref irtvutkwjdjkghobnnct
#
# Configure Delhivery One Tracking Push Webhook URL:
#   https://irtvutkwjdjkghobnnct.supabase.co/functions/v1/delhivery-webhook
